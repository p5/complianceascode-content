# platform = multi_platform_all
{{% for path in FILEPATH %}}
{{%- if IS_DIRECTORY and FILE_REGEX %}}
command('find {{{ path }}} -maxdepth 1 -type f -regextype posix-extended -regex "{{{ FILE_REGEX[loop.index0] }}}"').stdout.strip.split("\n").each do |entry|
  describe file(entry) do
    it { should_not be_more_permissive_than('{{{ FILEMODE }}}') }
  end
end
{{%- elif IS_DIRECTORY %}}
describe file('{{{ path }}}') do
  it { should be_directory }
  it { should_not be_more_permissive_than('{{{ FILEMODE }}}') }
end
{{%- else %}}
describe file('{{{ path }}}') do
  it { should_not be_more_permissive_than('{{{ FILEMODE }}}') }
end
{{%- endif %}}
{{% endfor %}}
